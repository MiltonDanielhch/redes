# Monitoreo de Infraestructura Regional - Configuración de Variables de Entorno
#
# Ubicación: `.env.example`
#
# Descripción: Plantilla de variables de entorno para el proyecto.
#              Copiar a .env.local y completar con valores reales.
#
# ADRs relacionados: 0002 (Config), 0008 (PASETO), 0020 (Monitoreo Regional)

# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=development
RUST_LOG=info

# Database (PostgreSQL - Primary)
DATABASE_URL=postgres://redes:redes@localhost:5432/redes

# Database (SQLite - Local-First for offline operation)
SQLITE_URL=file:./data/local.db

# Authentication (PASETO v4 - JWT PROHIBITED)
PASETO_SECRET=your-256-bit-secret-key-here-min-32-chars

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
MAIL_FROM=noreply@redes.gob.bo

# AWS S3 Storage
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
STORAGE_BUCKET=redes-assets

# Healthchecks.io (ADR 0014)
HC_API_KEY=your-healthchecks-api-key
HC_PING_URL=https://hc-ping.com/your-uuid-here

# Sentry (Optional)
SENTRY_DSN=

# Coolify
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=